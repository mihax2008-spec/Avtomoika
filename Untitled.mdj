nd","_id":"AAAAAAGgf3wAm6KXgsI=","_parent":{"$ref":"AAAAAAGgf3wAm6KWbpI="},"reference":{"$ref":"AAAAAAGgf1ehXQiy5/s="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf3wAm6KYg6c=","_parent":{"$ref":"AAAAAAGgf3wAm6KWbpI="},"reference":{"$ref":"AAAAAAGgf2iW9h4uF4Y="},"navigable":"navigable"}}],"documentation":"Владелец автомобиля, который пользуется интерфейсом системы для дистанционного выбора услуг мойки, бронирования времени и совершения онлайн-оплаты.\n"},{"_type":"UMLActor","_id":"AAAAAAGgf1frtQjc0dU=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Сотрудник","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGgf1xmkwqUXdI=","_parent":{"$ref":"AAAAAAGgf1frtQjc0dU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1xmkwqVbaQ=","_parent":{"$ref":"AAAAAAGgf1xmkwqUXdI="},"reference":{"$ref":"AAAAAAGgf1frtQjc0dU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1xmkwqWobE=","_parent":{"$ref":"AAAAAAGgf1xmkwqUXdI="},"reference":{"$ref":"AAAAAAGgf1jxuglgCTY="},"navigable":"navigable"}},{"_type":"UMLAssociation","_id":"AAAAAAGgf1x/pw0m0tM=","_parent":{"$ref":"AAAAAAGgf1frtQjc0dU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1x/pw0nUCU=","_parent":{"$ref":"AAAAAAGgf1x/pw0m0tM="},"reference":{"$ref":"AAAAAAGgf1frtQjc0dU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1x/pw0oTf0=","_parent":{"$ref":"AAAAAAGgf1x/pw0m0tM="},"reference":{"$ref":"AAAAAAGgf1lDVAmPFgI="},"navigable":"navigable"}},{"_type":"UMLAssociation","_id":"AAAAAAGgf4aWT9L0l74=","_parent":{"$ref":"AAAAAAGgf1frtQjc0dU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf4aWT9L1cvc=","_parent":{"$ref":"AAAAAAGgf4aWT9L0l74="},"reference":{"$ref":"AAAAAAGgf1frtQjc0dU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf4aWT9L2odY=","_parent":{"$ref":"AAAAAAGgf4aWT9L0l74="},"reference":{"$ref":"AAAAAAGgf4WA38LQ3LE="},"navigable":"navigable"}},{"_type":"UMLAssociation","_id":"AAAAAAGgf4ahFtXC2qU=","_parent":{"$ref":"AAAAAAGgf1frtQjc0dU="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf4ahFtXDyEE=","_parent":{"$ref":"AAAAAAGgf4ahFtXC2qU="},"reference":{"$ref":"AAAAAAGgf1frtQjc0dU="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf4ahFtXEtm4=","_parent":{"$ref":"AAAAAAGgf4ahFtXC2qU="},"reference":{"$ref":"AAAAAAGgf4ZNdMvapWY="},"navigable":"navigable"}}],"documentation":"Персонал автомойки (администратор или мойщик). Администратор контролирует общую занятость боксов, а мойщик переключает этапы выполнения работы в системе, чтобы клиент видел актуальный статус."},{"_type":"UMLActor","_id":"AAAAAAGgf1gFLQkGy+I=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Система Склад","documentation":"Внешняя автоматизированная система учета (например, 1С), которая удаленно принимает данные от нашей программы для автоматического списания автошампуней, воска, расходных материалов и химии по факту завершения каждого заказа."},{"_type":"UMLUseCase","_id":"AAAAAAGgf1iVcgkyFWo=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Запись на мойку","documentation":"Процесс оформления бронирования клиентом, включающий в себя выбор параметров, фиксацию времени заезда и обязательную предоплату."},{"_type":"UMLUseCase","_id":"AAAAAAGgf1jxuglgCTY=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Управление статусом заказа","ownedElements":[{"_type":"UMLInclude","_id":"AAAAAAGgf11pahaKlKk=","_parent":{"$ref":"AAAAAAGgf1jxuglgCTY="},"source":{"$ref":"AAAAAAGgf1jxuglgCTY="},"target":{"$ref":"AAAAAAGgf1lDVAmPFgI="}}],"documentation":"Прецедент, используемый персоналом для контроля за ходом работ. Позволяет изменять текущий статус обслуживания автомобиля на этапах: «В очереди», «В работе (моется)», «Готово к выдаче»."},{"_type":"UMLUseCase","_id":"AAAAAAGgf1lDVAmPFgI=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"Получение информации о бронировании","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGgf1zYVw/0IYA=","_parent":{"$ref":"AAAAAAGgf1lDVAmPFgI="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1zYVw/15LM=","_parent":{"$ref":"AAAAAAGgf1zYVw/0IYA="},"reference":{"$ref":"AAAAAAGgf1lDVAmPFgI="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGgf1zYVw/2VK8=","_parent":{"$ref":"AAAAAAGgf1zYVw/0IYA="},"reference":{"$ref":"AAAAAAGgf1gFLQkGy+I="},"navigable":"navigable"}}],"documentation":"Вспомогательный прецедент, который используется всеми участниками процесса для просмотра деталей заказа (номер брони, марка машины, перечень услуг). Система Склад обращается к нему автоматически для расчета списания материалов."},{"_type":"UMLUseCaseDiagram","_id":"AAAAAAGgf2gLMh0+nNk=","_parent":{"$ref":"AAAAAAFF+qBWK6M3Z8Y="},"name":"UseCaseDiagram2","ownedViews":[{"_type":"UMLActorView","_id":"AAAAAAGgf2hSaR2uUP0=","_parent":{"$ref":"AAAAAAGgf2gLMh0+nNk="},"model":{"$ref":"AAAAAAGgf1ehXQiy5/s="},"subViews":[{"_type":"UMLNameCompartmentView","_id":"AAAAAAGgf2hSaR2v3yU=","_parent":{"$ref":"AAAAAAGgf2hSaR2uUP0="},"model":{"$ref":"AAAAAAGgf1ehXQiy5/s="},"subViews":[{"_type":"LabelView","_id":"AAAAAAGgf2hSaR2wLKY=","_parent":{"$ref":"AAAAAAGgf2hSaR2v3yU="},"visible":false,"font":"Arial;13;0","left":-910,"top":6,"height":13},{"_type":"LabelView","_id":"AAAAAAGgf2hSaR2xlLw=","_parent":{"$ref":"AAAAAAGgf2hSaR2v3yU="},"font":"Arial;13;1","left":317,"top":358,"width":46.63330078125,"height":13,"text":"Клиент"},{"_type":"LabelView","_id":"AAAAAAGgf2hSaR2yus0=","_parent":{"$ref":"AAAAAAGgf2hSaR2v3yU="},"visible":false,"font":"Arial;13;0","left":-910,"top":6,"width":73.67724609375,"height":13,"text":"(from Model)"},{"_type":"LabelView","_id":"AAAAAAGgf2hSaR2zBhE=","_parent":{"$ref":"AAAAAAGgf2hSaR2v3yU="},"visible":false,"font":"Arial;13;0","left":-910,"top":6,"height":13,"horizontalAlignment":1}],"font":"Arial;13;0","left":312,"top":351,"width":56.63330078125,"height":25,"stereotypeLabel":{"$ref":"AAAAAAGgf2hSaR2wLKY="},"nameLabel":{"$ref":"AAAAAAGgf2hSaR2xlLw="},"namespaceLabel":{"$ref":"AAAAAAGgf2hSaR2yus0="},"propertyLabel":{"$ref":"AAAAAAGgf2hSaR2zBhE="}},{"_type":"UMLAttributeCompartmentView","_id":"AAAAAAGgf2hSaR